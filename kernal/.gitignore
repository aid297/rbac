# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/cmd/rbac/rbac
# kernal/rbac is the library package directory — never name a build output "rbac"
/rbac-server

# Cross-compiled release binaries (e.g. darwin-arm64.rbac)
/cmd/rbac/*.rbac

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (uncomment if not vendoring)
# vendor/

# Go workspace file
go.work
go.work.sum

# Local env overrides (RBAC_POLICY_KEY etc.)
.env
.env.local

# Runtime policy store, CA / TLS material, and logs (relative to process cwd)
/stats/
/secret/
/logs/
