<Project Sdk="Microsoft.NET.Sdk">

  <!-- One-shot generator: writes into Generated/rbac/v1/; Makefile flattens into Generated/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- No compileable sources; we only run the protobuf generator. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\rbac\v1\rbac.proto"
              GrpcServices="Both"
              ProtoRoot="..\..\proto"
              OutputDir="..\..\src\Rbac.Sdk\Generated"
              CompileOutputs="false" />
  </ItemGroup>

</Project>
